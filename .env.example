# ─────────────────────────────────────────────
# Kalshi API credentials
# Get these from: kalshi.com → Account → API Keys
# ─────────────────────────────────────────────

# The short key ID shown on your API key page
KALSHI_API_KEY_ID=

# The full RSA private key (everything including the BEGIN/END lines)
KALSHI_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----
PASTE_YOUR_KEY_HERE
-----END RSA PRIVATE KEY-----

# ─────────────────────────────────────────────
# Risk controls
# ─────────────────────────────────────────────

# Maximum dollars per single trade
MAX_BET_USDC=25.0

# Maximum number of open positions at once
MAX_OPEN_POSITIONS=5

# Minimum edge (our prob minus market price) required to place a bet
EDGE_THRESHOLD=0.08

# Fraction of full Kelly to wager (0.25 = quarter-Kelly, safer)
KELLY_FRACTION=0.25

# Total bankroll used for Kelly sizing calculations
MAX_BANKROLL_USDC=500.0

# ─────────────────────────────────────────────
# Bot timing
# ─────────────────────────────────────────────

# How often the bot scans for new signals, in seconds (3600 = hourly)
POLL_INTERVAL=3600

# ─────────────────────────────────────────────
# Active trading mode — more bets, faster, quicker profit-taking
# ─────────────────────────────────────────────

# Turn on active mode (true/false). When on, uses the ACTIVE_* values below.
ACTIVE_MODE=false

# Lower edge bar in active mode (0.04 = 4%, vs 0.08 standard)
ACTIVE_EDGE_THRESHOLD=0.04

# Scan interval in active mode, seconds (30 = every 30s; scans take ~1-5s)
ACTIVE_POLL_INTERVAL=30

# Max concurrent positions in active mode
ACTIVE_MAX_POSITIONS=15

# Sell winners once our side reaches this price (0.80 = 80¢)
PROFIT_TAKE_PRICE=0.80

# Bank a quick gain once a position is up this fraction (0.15 = +15%)
PROFIT_TAKE_PCT=0.15

# Cut a position once it has dropped this fraction of entry price
STOP_LOSS_PCT=0.55

# Skip markets whose bid-ask spread exceeds MAX_SPREAD (true to enable)
RESPECT_SPREAD=false
MAX_SPREAD=0.03

# ─────────────────────────────────────────────
# Strategy guardrails (data-driven)
# ─────────────────────────────────────────────

# HARD entry-price floor. Resolved data: entries under 40¢ went 5W/65L (-$752);
# entries 40-80¢ went 17W/6L (+$120). Only buy probable outcomes.
MIN_ENTRY_PRICE=0.45

# Only bet NO when the forecast is this many °F clear of the bucket
CONVICTION_MARGIN_F=3.0

# Momentum scalping (default OFF — gate-bypassing momentum entries lost -$400).
# When on, momentum can only waive the minimum-edge gate; the price floor,
# liquidity and forecast-direction gates always apply.
MOMENTUM_SCALP=false
MOMENTUM_THRESHOLD=0.03

# A stop-loss fires only after this many CONSECUTIVE scans below the stop
# (one-scan marks on thin books whipsaw; premature stops cost -$891)
STOP_CONFIRM_SCANS=2

# Close a scalp whose live edge dropped to ≤0 after this many hours (frees slots)
EDGE_GONE_EXIT_HOURS=2.0

# Max simultaneous positions on one physical event (city+date+high/low)
MAX_PER_EVENT=2

# Net Kalshi trading fees (0.07·P·(1−P) per contract) out of edges and P&L
MODEL_FEES=true
